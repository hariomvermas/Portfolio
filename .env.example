# Copy this file to .env.local and fill in what you need.
# .env.local is gitignored — never commit real values.

# ── Backend URL used by the contact form (Contact.jsx) ──
#
# Option A (recommended while developing): leave EMPTY.
#   The vite dev proxy (vite.config.js) forwards /api/* to
#   http://localhost:8080, so no CORS is involved at all.
#
#   VITE_API_BASE_URL=
#
# Option B: point straight at the backend (skips the proxy):
#   VITE_API_BASE_URL=http://localhost:8080
#
# In production the Vercel rewrite (vercel.json) forwards /api/* to the
# deployed backend, so this stays empty there too. Set a real URL only
# if you ever host the frontend and backend on different origins.
